
#Filesystem

HEADER_DIR := include/
SOURCE_DIR := src/
BUILD_DIR := build/
MKDIR := mkdir
REMOVE := rm
REMOVE_DIR_FLAG := -R
REMOVE_FORCE_FLAG := -f

#DEBUGGER

GNU_CPP_DBG := gdb

#Compilers

CPP_COMPILER := g++
CPP_COMPILER_OUTPUT_FLAG := -o
CPP_COMPILER_INCLUDE_DIR_FLAG := -I
CPP_COMPILER_VERSION := -std=c++23

#debugging symbols

CPP_COMPILER_DEBUGGER_SYMBOL_FLAG := -g
CPP_COMPILER_NO_OPTIMIZATION_FLAG := -O0

CPP_DBG_BUILD_FLAGS := $(CPP_COMPILER_DEBUGGER_SYMBOL_FLAG) $(CPP_COMPILER_NO_OPTIMIZATION_FLAG)

#Syntax  Checker

CPP_COMPILER_WALL_FLAG := -Wall
CPP_COMPILER_WEXT_FLAG := -Wextra
CPP_COMPILER_WPED_FLAG := -Wpedantic
CPP_COMPILER_SYNTAX_FLAG := -fsyntax-only
CPP_SYNTAX_CHECKER := $(CPP_COMPILER_WALL_FLAG) \
		      $(CPP_COMPILER_WEXT_FLAG) \
		      $(CPP_COMPILER_WPED_FLAG) \
		      $(CPP_COMPILER_SYNTAX_FLAG)

CPP_COMPILER_WITH_OPTIMIZATION_FLAG := -O2

CPP_SOURCE_DIR := $(wildcard $(SOURCE_DIR)*.cpp)
CPP_OUTPUT_BIN := a.out






